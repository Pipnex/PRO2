{
  "manifest_version": 3,
  "name": "Pipnex Trade Lens — AI Market Brain",
  "version": "1.0.0",
  "description": "Real-time Institutional SMC & Trade Lens Analysis directly on TradingView charts.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "http://localhost:8899/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
